<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ObjectRT runtime + MonoGame bindings -->
    <ProjectReference Include="..\..\src\ObjectRT.Runtime\ObjectRT.Runtime.csproj" />
    <ProjectReference Include="..\..\src\ObjectRT.MonoGame\ObjectRT.MonoGame.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ObjectIL game script, copied next to the exe -->
    <None Include="game.oil" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
