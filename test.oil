module DllDemo version 1.0.0

@DllImport("kernel32.dll")
class Kernel32 {
    static method GetTickCount() -> int32      { ldc.i4 0 ret }
    static method Sleep(ms: int32) -> void     { ret }
    static method GetModuleHandle(name: string) -> int32 { ldc.i4 0 ret }
}

@DllImport("user32.dll")
class User32 {
    static method MessageBox(hWnd: int32, text: string, caption: string, kind: int32) -> int32 { ldc.i4 0 ret }
    static method GetSystemMetrics(index: int32) -> int32 { ldc.i4 0 ret }
}

class Tests {
    static method Test1_TickCount() -> int32 {
        call Kernel32.GetTickCount()
        call Kernel32.GetTickCount()
        pop
        ldc.i4 1
        ret
    }
    static method Test2_Sleep() -> int32 {
        ldc.i4 50
        call Kernel32.Sleep(int32)
        ldc.i4 1
        ret
    }
    static method Test3_ScreenWidth() -> int32 {
        ldc.i4 0
        call User32.GetSystemMetrics(int32)
        ret
    }
    static method Test3_ScreenHeight() -> int32 {
        ldc.i4 1
        call User32.GetSystemMetrics(int32)
        ret
    }
    static method Test4_ModuleHandle() -> int32 {
        ldstr "user32.dll"
        call Kernel32.GetModuleHandle(string)
        ldc.i4 0
        cne
        ret
    }
    static method Test5_MessageBox() -> int32 {
        ldc.i4 0
        ldstr "This dialog was opened entirely\nfrom ObjectIL bytecode!\n\n@DllImport(\"user32.dll\") called\nvia the call opcode."
        ldstr "ObjectIL @DllImport Test"
        ldc.i4 64
        call User32.MessageBox(int32, string, string, int32)
        ret
    }
}

class Program
{
    static method Main() -> void {
        call Tests.Test5_MessageBox() -> int32
     
        local t: int32
        ldc.i4 1
        while (stack)
        {
            ldloc t
            ldc.i4 1
            add
            stloc t
            ldc.i4 1
        }
    }
}